{
  "name": "@pj21/debug-menu",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "In-app debug menu for Expo and React Native. Pure JS plugins, shake/tap triggers, and a Metro production stub.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./log": {
      "react-native": "./src/log/index.ts",
      "types": "./lib/typescript/log/index.d.ts",
      "import": "./lib/module/log/index.js",
      "require": "./lib/commonjs/log/index.js",
      "default": "./lib/commonjs/log/index.js"
    },
    "./events": {
      "react-native": "./src/events/index.ts",
      "types": "./lib/typescript/events/index.d.ts",
      "import": "./lib/module/events/index.js",
      "require": "./lib/commonjs/events/index.js",
      "default": "./lib/commonjs/events/index.js"
    },
    "./network": {
      "react-native": "./src/network/index.ts",
      "types": "./lib/typescript/network/index.d.ts",
      "import": "./lib/module/network/index.js",
      "require": "./lib/commonjs/network/index.js",
      "default": "./lib/commonjs/network/index.js"
    },
    "./convex": {
      "react-native": "./src/convex/index.ts",
      "types": "./lib/typescript/convex/index.d.ts",
      "import": "./lib/module/convex/index.js",
      "require": "./lib/commonjs/convex/index.js",
      "default": "./lib/commonjs/convex/index.js"
    },
    "./environment": {
      "react-native": "./src/environment/index.ts",
      "types": "./lib/typescript/environment/index.d.ts",
      "import": "./lib/module/environment/index.js",
      "require": "./lib/commonjs/environment/index.js",
      "default": "./lib/commonjs/environment/index.js"
    },
    "./feature-flags": {
      "react-native": "./src/feature-flags/index.ts",
      "types": "./lib/typescript/feature-flags/index.d.ts",
      "import": "./lib/module/feature-flags/index.js",
      "require": "./lib/commonjs/feature-flags/index.js",
      "default": "./lib/commonjs/feature-flags/index.js"
    },
    "./info": {
      "react-native": "./src/info/index.ts",
      "types": "./lib/typescript/info/index.d.ts",
      "import": "./lib/module/info/index.js",
      "require": "./lib/commonjs/info/index.js",
      "default": "./lib/commonjs/info/index.js"
    },
    "./actions": {
      "react-native": "./src/actions/index.ts",
      "types": "./lib/typescript/actions/index.d.ts",
      "import": "./lib/module/actions/index.js",
      "require": "./lib/commonjs/actions/index.js",
      "default": "./lib/commonjs/actions/index.js"
    },
    "./shake": {
      "react-native": "./src/shake/index.ts",
      "types": "./lib/typescript/shake/index.d.ts",
      "import": "./lib/module/shake/index.js",
      "require": "./lib/commonjs/shake/index.js",
      "default": "./lib/commonjs/shake/index.js"
    },
    "./metro": {
      "types": "./src/metro/index.d.ts",
      "require": "./src/metro/index.js",
      "default": "./src/metro/index.js"
    },
    "./noop": {
      "react-native": "./src/noop/index.ts",
      "types": "./lib/typescript/noop/index.d.ts",
      "import": "./lib/module/noop/index.js",
      "require": "./lib/commonjs/noop/index.js",
      "default": "./lib/commonjs/noop/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "log": [
        "lib/typescript/log/index.d.ts"
      ],
      "events": [
        "lib/typescript/events/index.d.ts"
      ],
      "network": [
        "lib/typescript/network/index.d.ts"
      ],
      "convex": [
        "lib/typescript/convex/index.d.ts"
      ],
      "environment": [
        "lib/typescript/environment/index.d.ts"
      ],
      "feature-flags": [
        "lib/typescript/feature-flags/index.d.ts"
      ],
      "info": [
        "lib/typescript/info/index.d.ts"
      ],
      "actions": [
        "lib/typescript/actions/index.d.ts"
      ],
      "shake": [
        "lib/typescript/shake/index.d.ts"
      ],
      "metro": [
        "src/metro/index.d.ts"
      ],
      "noop": [
        "lib/typescript/noop/index.d.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --outDir lib/commonjs",
    "build:esm": "tsc -p tsconfig.build.json --module esnext --outDir lib/module",
    "build:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx,js}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "changeset": "changeset",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "debug",
    "debug-menu",
    "developer-tools",
    "network-logger",
    "feature-flags",
    "convex",
    "websocket"
  ],
  "author": "Pooya Jalali",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooyaj21/debug-menu.git"
  },
  "peerDependencies": {
    "expo-sensors": "*",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-gesture-handler": "*",
    "react-native-network-logger": "*",
    "react-native-safe-area-context": ">=4",
    "react-native-screens": ">=4"
  },
  "peerDependenciesMeta": {
    "expo-sensors": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-network-logger": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@changesets/cli": "^2.29.8",
    "@react-native/babel-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "babel-jest": "^30.5.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "homepage": "https://github.com/pooyaj21/debug-menu#readme",
  "bugs": {
    "url": "https://github.com/pooyaj21/debug-menu/issues"
  }
}
